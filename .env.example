# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

###=== Dev profile ===###
# Used by: make dev, make generate-dev-sql, docker-compose.yml

# Password for the PostgreSQL superuser (postgres) in the Docker container
POSTGRES_PWD=changeme

# Password for the application database user (articleservice)
DEV_ARTICLE_SERVICE_USER_PWD=changeme

# Password for the Liquibase migration user (containeradmin)
DEV_LIQUIBASE_USER_PWD=changeme

###=== Prod profile ===###

# Password for the application database user
PROD_ARTICLE_SERVICE_USER_PWD=changeme

# Password for the Liquibase migration user
PROD_LIQUIBASE_USER_PASSWORD=changeme
